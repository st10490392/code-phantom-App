<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         This also covers the app's own API calls in a debug build (e.g. to
         a local development backend) — no separate permission is needed
         for that.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only: allow cleartext (plain HTTP) traffic so the app can
         reach a local development backend with no TLS certificate — see
         res/xml/network_security_config.xml. Merged only into the debug
         manifest; profile and release builds never get this attribute. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
